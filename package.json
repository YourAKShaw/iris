{
  "name": "irisveil",
  "version": "1.0.0",
  "description": "IrisVeil turns a company website into a cited research brief and three personalized outreach drafts. Every fact is checked against the source page before an email can use it.",
  "license": "AGPL-3.0-only",
  "author": "Ayush Kumar Shaw",
  "homepage": "https://github.com/YourAKShaw/irisveil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourAKShaw/irisveil.git"
  },
  "bugs": {
    "url": "https://github.com/YourAKShaw/irisveil/issues"
  },
  "keywords": [
    "lead-research",
    "outreach",
    "ai-agent",
    "llm",
    "founder-tools",
    "yourakshaw"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "irisveil": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:serve": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
