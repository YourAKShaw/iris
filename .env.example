# Iris configuration. Copy to .env and fill in LLM_API_KEY.
# Variables already set in your shell take precedence over this file.

# --- Model provider (any OpenAI-compatible chat-completions API) -------------
# groq (default, free plan) | gemini (free tier) | openrouter | ollama (local) | openai | custom
LLM_PROVIDER=groq
# Free Groq key: https://console.groq.com/keys   Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional overrides. Defaults: groq -> openai/gpt-oss-120b, gemini -> gemini-3.8-flash.
# Required for openrouter, ollama, openai and custom.
# LLM_MODEL=
# LLM_BASE_URL=
# json_object (default) or off. Iris falls back to off automatically if the provider rejects JSON mode.
# LLM_JSON_MODE=json_object
# off | none | minimal | low | medium | high. Groq and Gemini default to low to save tokens.
# LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=
# LLM_TIMEOUT_SECONDS=45

# --- Who the emails come from -------------------------------------------------
SENDER_NAME=Ayush
SENDER_COMPANY=NayaManas
SENDER_OFFER=NayaManas designs and ships AI agents and workflow automation for founder-led teams: lead research and outreach, support triage, and internal knowledge assistants.

# --- Website fetching ---------------------------------------------------------
# FETCH_MAX_PAGES=4
# FETCH_TIMEOUT_SECONDS=8
# Dev/test only. Turns OFF SSRF protection so Iris can read localhost. Never enable in a deployment.
# IRIS_ALLOW_PRIVATE_HOSTS=false

# --- Web server (iris serve) --------------------------------------------------
# HOST=127.0.0.1
# PORT=3000
# Number of trusted reverse proxies in front of the app (Render: 1). 0 ignores X-Forwarded-For.
# TRUST_PROXY_HOPS=0
# RATE_LIMIT_PER_IP=5
# RATE_LIMIT_WINDOW_MINUTES=10
# Fresh runs per UTC day. 25 runs at roughly 7K tokens each fits Groq's free 200K tokens/day.
# DAILY_RUN_LIMIT=25
# MAX_CONCURRENT_RUNS=2
# Identical inputs are served from memory for this long. 0 disables the cache.
# CACHE_TTL_MINUTES=360
# RUN_TIMEOUT_SECONDS=90
